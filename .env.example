ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=bulfinch_mythology
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
PDF_PATH=./data/ageoffableorstor00bulf_0.pdf
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.40
MAX_RETRIEVAL_ATTEMPTS=3

# Ajustes opcionais para uma VM pequena (como OCI E2.1.Micro)
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
ORT_NUM_THREADS=1

RAG_IMAGE=rag-mitologia:local
CADDY_SITE=:80
HTTP_PORT=8080
HTTPS_PORT=8443
